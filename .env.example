# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / VITE_APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, payment redirects, and API endpoints.
APP_URL="MY_APP_URL"
VITE_APP_URL="MY_APP_URL"
URL="MY_APP_URL"

# AtexPay Payment Gateway Configuration
# Required for processing live payments via AtexPay checkout
ATEXPAY_API_KEY="your_atexpay_api_key_here"
NEXT_PUBLIC_ATEXPAY_API_KEY="your_atexpay_api_key_here"
VITE_ATEXPAY_API_KEY="your_atexpay_api_key_here"
ATEXPAY_BASE_URL="https://api.atexpay.com"
ATEXPAY_WEBHOOK_SECRET="your_atexpay_webhook_secret_here"

# Supabase Real-Time Backend (Optional: Can also be configured in-app via the Supabase modal)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

